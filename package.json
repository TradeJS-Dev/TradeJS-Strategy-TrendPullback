{
  "name": "@tradejs/strategy-trend-pullback",
  "version": "0.1.0",
  "description": "EMA trend continuation after a timed RSI pullback and candle close confirmation for TradeJS.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "24.x"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "prettify": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsup",
    "test": "node --test tests/*.test.mjs",
    "checks": "yarn format:check && yarn typecheck && yarn build && yarn test"
  },
  "devDependencies": {
    "@tradejs/core": "3.1.28",
    "@tradejs/strategy-kit": "3.0.6",
    "@tradejs/types": "3.1.28",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@tradejs/core": "^3.1.28 || ^3.1.29-beta.275",
    "@tradejs/strategy-kit": "^3.0.6",
    "@tradejs/types": "^3.1.28 || ^3.1.29-beta.275"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "UNLICENSED"
}
